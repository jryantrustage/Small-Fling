Panel.tsx ├── SearchTracePanel.tsx ├── types.ts ├── useWorkflowSocket.ts └── WorkItemMatchesGrid.tsx File Contents 1. C:\DevAnalysis\internal-open-source\Matrix\output\workbook.json { "sourceFile": "C:\\DevAnalysis\\internal-open-source\\Matrix\\input\\State Requirements for FICUS eApp.xlsx", "generatedAt": "2026-09-17T15:09:28.442Z", "worksheets": [ { "name": "Voice Signature Page", "rows": [ { "row": 1, "cells": [ { "column": 1, "address": "A1", "value": "Topic" }, { "column": 2, "address": "B1", "value": "Notes" }, { "column": 3, "address": "C1", "value": "Content to be read by agent:" }, { "column": 4, "address": "D1", "value": "Notes" }, { "column": 5, "address": "E1", "value": null }, { "column": 6, "address": "F1", "value": null } ] }, { "row": 2, "cells": [ { "column": 1, "address": "A2", "value": "Initial Disclosure and Fraud Statement" }, { "column": 2, "address": "B2", "value": null }, { "column": 3, "address": "C2", "value": "The final step will be to record your voice signature. To begin, I&apos;ll share a brief disclosure with you, ask you to confirm a couple of items, and then gather your voice signature.\r\n\r\nNew York: “You have a right to apply for this coverage and authorize payment in writing.”\r\n“The final step is to record your voice signature. This includes questions regarding your desire to enter into an electronic transaction, the amount of Coverage, billing options, and a review of the health questions I asked earlier. After you respond I will ask you to state your full name and today’s date, which is your signature and authorization to this agreement.”" }, { "column": 4, "address": "D2", "value": "Note: per discussion with Mindy Umthum (Compliance), we can remove the statement \"you have a right to apply for this coverage and authorize payment in writing\" for all states except New York. Aaron deleted this as a result." }, { "column": 5, "address": "E2", "value": null }, { "column": 6, "address": "F2", "value": null } ] }, { "row": 3, "cells": [ { "column": 1, "address": "A3", "value": null }, { "column": 2, "address": "B3", "value": "Fraud" }, { "column": 3, "address": "C3", "value": "See &apos;Fraud Language&apos; tab and populate the appropriate fraud language" }, { "column": 4, "address": "D3", "value": null }, { "column": 5, "address": "E3", "value": null }, { "column": 6, "address": "F3", "value": null } ] }, { "row": 4, "cells": [ { "column": 1, "address": "A4", "value": null }, { "column": 2, "address": "B4", "value": "Replace [CMFG] with [MEMBERS] for TAWL and TAWL 2.0" }, { "column": 3, "address": "C4", "value": "I am a licensed and appointed insurance agent representing TruStage Insurance Agency. I offer, sell, and service insurance products underwritten by [CMFG] Life Insurance Company. My employer and I receive compensation through the sale of insurance products. The insurance products are not federally insured, may lose value and are not guaranteed by any other financial institution.\r\n\r\nNew York: “I am a licensed and appointed insurance agent representing TruStage Insurance Agency. I offer, sell, and service insurance products underwritten by CMFG Life Insurance Company. My employer and I receive compensation through the sale of insurance products. The insurance products are not federally insured, may lose value and are not guaranteed by any other financial institution.”" }, { "column": 4, "address": "D4", "value": null }, { "column": 5, "address": "E4", "value": null }, { "column": 6, "address": "F4", "value": null } ] }, { "row": 5, "cells": [ { "column": 1, "address": "A5", "value": "Coverage" }, { "column": 2, "address": "B5", "value": "Prefill applied for coverage amount and type" }, { "column": 3, "address": "C5", "value": "Are you applying for [$5,000] of [term/whole] life insurance [along with a [$25,000] [Accidental Death Benefit Rider]]? " }, { "column": 4, "address": "D5", "value": "Display coverage amount, product type, and if applicable, coverage and name of Rider" }, { "column": 5, "address": "E5", "value": null }, { "column": 6, "address": "F5", "value": null } ] }, { "row": 6, "cells": [ { "column": 1, "address": "A6", "value": "Coverage" }, { "column": 2, "address": "B6", "value": "Only required for New York" }, { "column": 3, "address": "C6", "value": "Read when beneficiary type is Person/organization:\r\n“You provided [Beneficiary full name] as your [specify beneficiary class as primary/contingent and percentage share of death benefit as provided] beneficiary. Is this correct? \r\n\r\nRead when beneficiary type is If trust/estate:\r\n\"You provided [Trust/Estate] of [name of proposed insured] as a beneficiary with the identifying details. Is this correct? \"" }, { "column": 4, "address": "D6", "value": null }, { "column": 5, "address": "E6", "value": null }, { "column": 6, "address": "F6", "value": null } ] }, { "row": 7, "cells": [ { "column": 1, "address": "A7", "value": "Replacement" }, { "column": 2, "address": "B7", "value": "NAIC Model States" }, { "column": 3, "address": "C7", "value": "AL, AK, AZ, AR, CO, CT, HI, IA, KY, LA, ME, MD, MS, MO, MT, NE, NH, NJ, NM, NC, OH, OR, RI, SC, SD, TX, UT, VT, VA, WV, WI" }, { "column": 4, "address": "D7", "value": null }, { "column": 5, "address": "E7", "value": null }, { "column": 6, "address": "F7", "value": null } ] }, { "row": 8, "cells": [ { "column": 1, "address": "A8", "value": null }, { "column": 2, "address": "B8", "value": "If \"No\" to existing insurance" }, { "column": 3, "address": "C8", "value": "You indicated you do not currently have life insurance. Is this correct?" }, { "column": 4, "address": "D8", "value": "Existing Insurance Question = Do you have any existing life insurance policies or annuity contracts with our company or any other company?" }, { "column": 5, "address": "E8", "value": null }, { "column": 6, "address": "F8", "value": null } ] }, { "row": 9, "cells": [ { "column": 1, "address": "A9", "value": null }, { "column": 2, "address": "B9", "value": 