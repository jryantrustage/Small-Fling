.json
{
"name": "astro-ui",
"version": "0.1.0",
"private": true,
"scripts": {
"build": "react-scripts build",
"compile-sass": "node-sass src/assets/scss/material-dashboard-pro-react.scss src/assets/css/material-dashboard-pro-react.css",
"deploy": "npm run build",
"fix": "lint-staged",
"install:clean": "rm -rf node_modules/ && npm install && npm start",
"lint:check": "tsc --noEmit && eslint \"*/**/*.{js,jsx,ts,tsx}\" --quiet",
"lint:fix": "tsc --noEmit && eslint \"*/**/*.{js,jsx,ts,tsx}\" --quiet --fix",
"map-sass": "node-sass src/assets/scss/material-dashboard-pro-react.scss src/assets/css/material-dashboard-pro-react.css --source-map true",
"minify-sass": "node-sass src/assets/scss/material-dashboard-pro-react.scss src/assets/css/material-dashboard-pro-react.min.css --output-style compressed",
"prepare": "husky install",
"pretty": "prettier --check \"src/**/{!(index),}.{js,jsx,ts,tsx,css}\"",
"pretty:fix": "prettier --write \"src/**/{!(index),}.{js,jsx,ts,tsx,css}\"",
"start": "react-scripts start",
"test": "react-scripts test --env=jsdom --watchAll=false",
"test:coverage": "react-scripts test --env=jsdom --watchAll=false --coverage",
"test:update-snapshots": "react-scripts test --env=jsdom --watchAll=false -u",
"test:watch": "react-scripts test --env=jsdom"
},
"lint-staged": {
"src/**/*.{js,jsx,ts,tsx}": [
"eslint --fix",
"prettier --write"
]
},
"browserslist": {
"production": [
">0.2%",
"not dead",
"not op_mini all"
],
"development": [
"last 1 edge version",
"last 1 chrome version",
"last 1 firefox version",
"last 1 safari version"
]
},
"jest": {
"collectCoverageFrom": [
"**/*.{js,jsx,ts,tsx}",
"!**/*.d.ts",
"!**/**/types.ts",
"!**/**/types/*.{ts,tsx}",
"!**/index.{js,jsx,ts,tsx}",
"!react-app-env.d.ts",
"!**/src/API/**",
"!**/src/App.tsx",
"!**/src/assets/**",
"!**/components/Card/**",
"!**/components/Clearfix/**",
"!**/components/CoreProduct/CustomSection/PrebuiltSection/**",
"!**/components/CustomDropdown/**",
"!**/components/CustomButtons/**",
"!**/components/CustomInput/**",
"!**/components/Heading/**",
"!**/components/InfoArea/**",
"!**/components/MapCoreProductTemplates/**",
"!**/components/Navbars/**",
"!**/components/Sidebar/**",
"!**/components/Snackbar/**",
"!**/components/Typography/**",
      "!**/components/_mock__/**",
"!**/context/index.js",
"!**/src/views/Pages/**",
"!**/src/views/Components/AddressCard.tsx",
"!**/src/variables/**",
"!**/src/layouts/**",
"!**/components/__test__/TestUtils.ts",
"!**/components/CoreProduct/Rates/**",
"!**/components/CoreProduct/CustomSection/Sections/CreditCard.tsx",
"!**/components/CoreProduct/CustomSection/Sections/DemoSection.tsx",
"!**/components/CoreProduct/CustomSection/Sections/PersonalLoan.tsx",
"!**/components/CoreProduct/CustomSection/Sections/PLOC.tsx",
"!**/components/CoreProduct/CustomSection/Sections/RatesAuto.tsx",
"!**/components/CoreProduct/CustomSection/Sections/RatesUnsecuredLoan.tsx",
"!**/components/CoreProduct/CustomSection/Sections/RecreationalVehicle.tsx",
"!**/components/CoreProduct/CustomSection/Sections/SecuredProductOptions.tsx",
"!**/components/CoreProduct/CustomSection/dimensions/configuration/**",
"!**/components/CoreProduct/CustomSection/dimensions/DimensionControlPanel.tsx",
"!**/components/CoreProduct/CustomSection/dimensions/DimensionFilter.tsx",
"!**/components/CoreProduct/CustomSection/hooks/useDimensionFilter.ts"
],
"coverageThreshold": {
"global": {
"branches": 20,
"functions": 20,
"lines": 20,
"statements": 20
}
},
"moduleNameMapper": {
"^,*material-dashboard-pro-react.scss(.*)$": " <rootDir>/src/components/__mock__/styleMock.js"
}
},
