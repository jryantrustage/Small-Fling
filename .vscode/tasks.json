{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "adb: connect wifi",
            "type": "shell",
            "command": "adb connect 192.168.86.81:43677",
            "problemMatcher": []
        },
        {
            "label": "adb: stay awake and unlock",
            "type": "shell",
            "command": "adb -s 192.168.86.81:43677 shell \"settings put global stay_on_while_plugged_in 7 && svc power stayon true && input keyevent KEYCODE_WAKEUP && wm dismiss-keyguard\"",
            "problemMatcher": []
        },
        {
            "label": "gradle: assembleDebug",
            "type": "shell",
            "command": "./gradlew assembleDebug",
            "windows": {
                "command": ".\\gradlew.bat assembleDebug"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "gradle: clean assembleDebug",
            "type": "shell",
            "command": "./gradlew clean assembleDebug",
            "windows": {
                "command": ".\\gradlew.bat clean assembleDebug"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "adb: install and run",
            "type": "shell",
            "command": "adb -s 192.168.86.81:43677 install -r app/build/outputs/apk/debug/app-debug.apk && adb -s 192.168.86.81:43677 shell am start -n com.matrixcapture.app/.ui.MainActivity",
            "dependsOn": [
                "gradle: assembleDebug"
            ],
            "problemMatcher": []
        },
        {
            "label": "adb: grant overlay permission",
            "type": "shell",
            "command": "adb -s 192.168.86.81:43677 shell appops set com.matrixcapture.app SYSTEM_ALERT_WINDOW allow",
            "problemMatcher": []
        },
        {
            "label": "server: install requirements",
            "type": "shell",
            "command": "pip install -r server/requirements.txt",
            "problemMatcher": []
        },
        {
            "label": "server: run fastapi",
            "type": "shell",
            "command": "python server/main.py",
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": "^(?!.*)$",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*Starting MatrixCapture FastAPI backend.*",
                        "endsPattern": ".*Application startup complete.*"
                    }
                }
            ]
        },
        {
            "label": "web: install",
            "type": "shell",
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}/web"
            },
            "problemMatcher": []
        },
        {
            "label": "web: dev",
            "type": "shell",
            "command": "npm run dev -- --host 0.0.0.0 --port 5173",
            "options": {
                "cwd": "${workspaceFolder}/web"
            },
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": "^(?!.*)$",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*VITE.*",
                        "endsPattern": ".*(Local:|ready in).*"
                    }
                }
            ]
        },
        {
            "label": "web: build",
            "type": "shell",
            "command": "npm run build",
            "options": {
                "cwd": "${workspaceFolder}/web"
            },
            "group": "build",
            "problemMatcher": []
        }
    ]
}
