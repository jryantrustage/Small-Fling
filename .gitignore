# Server Storage & Database State (server/storage)
# Ignore uploaded frames and generated data, but keep directory structure
server/storage/frames/*
!server/storage/frames/.gitkeep
server/storage/data/*
!server/storage/data/.gitkeep

# General Databases & SQLite
*.db
*.sqlite
*.sqlite3

