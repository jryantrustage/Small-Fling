# ==============================================================================
# Matrix Capture Studio - Configuration Template (.env.example)
# Copy this file to .env and configure your environment-specific values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI OCR & Multimodal Vision
# ------------------------------------------------------------------------------
# Gemini API Key (get yours from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Vision OCR Model
GEMINI_PRIMARY_MODEL=gemini-3.6-flash

# Comma-separated fallback models in order of priority when primary is busy (503/429)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Retry settings for transient API failures
GEMINI_RETRY_ATTEMPTS=3
GEMINI_RETRY_BACKOFF_BASE=2.0

# Token pricing estimates (USD per 1,000,000 tokens)
GEMINI_PRICE_PER_MILLION_PROMPT_TOKENS=0.075
GEMINI_PRICE_PER_MILLION_CANDIDATE_TOKENS=0.30

# ------------------------------------------------------------------------------
# 2. FastAPI Backend Server & Networking
# ------------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Comma-separated allowed origins or * for all
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 3. Pacer & Document Defaults
# ------------------------------------------------------------------------------
TARGET_TOTAL_LINES=9487
PACER_LINE_PITCH_PX=32.0
PACER_AUTO_TUNE_FACTOR=1.0

# ------------------------------------------------------------------------------
# 4. Web Frontend Configuration (Vite import.meta.env)
# ------------------------------------------------------------------------------
# URL of the MatrixCapture FastAPI backend
VITE_API_BASE_URL=http://127.0.0.1:8000

# Document & telemetry polling frequency in milliseconds
VITE_POLL_INTERVAL_MS=1200

# Default target line count displayed in Web UI
VITE_DEFAULT_TARGET_LINES=9487
